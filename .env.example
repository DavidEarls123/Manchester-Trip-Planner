# Get a free key at https://serpapi.com (free plan includes monthly searches).
# Leave blank to run with demo (fake) flight data.
SERPAPI_KEY=

# Port for the local web server
PORT=3000

# How long to cache flight searches, in minutes (saves your API quota)
FLIGHT_CACHE_MINUTES=180

# Optional PIN required to search (recommended when the app is online)
APP_PIN=
